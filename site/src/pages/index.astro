---
import "../styles/global.css";

// Items marked todo render with a dashed outline until the real copy is in.
const work = [
  {
    name: "NatureIQ",
    org: "CSIRO",
    href: "https://www.csiro.au/en/showcase/csiro-natureiq",
    year: "2024 to now",
    about: "CSIRO's SaaS platform that turns ecological research into biodiversity and sustainability insights for organisations.",
    did: "Integrated a land-carbon science model into the platform, automated client onboarding from dozens of manual steps to one, and built the admin app and system monitoring. Individually recognised with a CSIRO award and reward for this work.",
    tags: ["AWS Lambda", "Step Functions", "Python", "R", "HPC"],
  },
  {
    name: "Sciansa",
    org: "CSIRO",
    href: "https://www.csiro.au/en/research/technology-space/ai/science-digital",
    year: "2025 to now",
    about: "CSIRO's AI-for-science platform, giving researchers a trusted environment for AI tools, agents and scientific workflows.",
    did: "Took over the web app at short notice and kept delivery on track. Rebuilt CI/CD with automated tests, then shipped a tools catalogue, versioning, live run updates and an agent registry.",
    tags: ["TypeScript", "GitHub Actions", "CI/CD", "Automated testing", "AI agents"],
  },
  {
    name: "TERN IV",
    org: "CSIRO",
    href: "https://www.tern.org.au/",
    year: "2026 to now",
    about: "Calibrating CSIRO's WAVES model, which simulates how water, carbon and energy move between soil, plants and the atmosphere.",
    did: "Refactored and recompiled the original Windows model to run on CSIRO's Petrichor HPC cluster, optimised the code for HPC, and implemented a shuffled complex evolution optimiser to effectively parameterise the model.",
    tags: ["Fortran", "Python", "Bash", "Slurm", "HPC"],
  },
  {
    name: "Posit Connect platform",
    org: "CSIRO",
    year: "2025 to 2026",
    about: "The shared platform research units and enterprise teams across CSIRO use to host their web apps.",
    did: "Built daily scanners that catch misconfigured apps and invalid permissions, an account management app and load balancer dashboards. They still run every day and cut routine admin work.",
    tags: ["R", "Shiny", "Posit Connect", "Automation", "Monitoring"],
  },
  {
    name: "Marine Language Toolkit",
    org: "CSIRO",
    year: "2024 to 2025",
    about: "Tools for gathering, analysing and visualising sentiment data for marine research.",
    did: "Built the interactive app and automated data pipeline. Researchers used it in two papers, including one on how Great Barrier Reef coral reporting fed a spike in climate science denial.",
    tags: ["R", "Shiny", "Data pipelines"],
  },
];

const more = [
  { name: "Bitbucket to GitHub migration tooling", org: "CSIRO", year: "2025" },
  { name: "ParaView animation of compressed air energy storage", org: "CSIRO", year: "2025" },
  {
    name: "Busting, most philanthropic project",
    org: "UQCS Hackathon",
    year: "2020",
    href: "https://github.com/lachlanharnett/UQCS-Hackathon-2020",
  },
];

const experience = [
  { role: "Research Software Engineer", org: "CSIRO, Scientific Computing", when: "2024 to now" },
  { role: "Data Analyst, graduate program", org: "CSIRO, Scientific Computing", when: "2024" },
  { role: "Academic Tutor", org: "Union College, Brisbane", when: "2023 to 2024" },
  { role: "Bachelor of Computer Science", org: "University of Queensland", when: "2023" },
];

const stack = [
  {
    group: "ai",
    items: ["AI-assisted SDLC", "Loop engineering", "Spec-driven development", "GitHub Spec Kit", "MCP servers", "Agent skills"],
  },
  {
    group: "code",
    items: ["Python", "R", "TypeScript", "JavaScript", "C", "C++", "C#", "Fortran", "Bash", "SQL", "React", "Shiny"],
  },
  {
    group: "infra",
    items: ["AWS", "GCP", "HPC", "Slurm", "Docker", "GitHub Actions", "Dask", "Postgres", "DynamoDB", "Linux"],
  },
  { group: "science", items: ["QGIS", "ParaView", "Posit Connect"] },
];

const links = [
  { label: "github", href: "https://github.com/lachlanharnett" },
  { label: "linkedin", href: "https://www.linkedin.com/in/lachlan-harnett-6646b8200/" },
  { label: "email", href: "mailto:lachlanjharnett@gmail.com" },
  { label: "resume.pdf", href: "/resume.pdf" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lachlan Harnett</title>
    <meta name="description" content="Lachlan Harnett, research software engineer at CSIRO." />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="wrap top">
      <a class="mark mono" href="/">ha<span>rnett.au</span><i class="caret" aria-hidden="true"></i></a>
      <nav class="mono">
        <a href="#projects">projects</a>
        <a href="#experience">experience</a>
        <a href="#contact">contact</a>
      </nav>
    </header>

    <main class="wrap">
      <section class="hero">
        <p class="mono kicker">~ $ whoami</p>
        <h1>
          I'm Lachlan Harnett, a research software engineer{" "}
          <em>building software for science.</em>
        </h1>
        <p class="lede">
          I work in the Scientific Computing group at CSIRO, Australia's national science agency,
          turning what researchers need into backend software, cloud infrastructure and automated
          research workflows. I'm happiest working on technology that makes a real difference to people.
        </p>
        <p class="mono status"><span class="dot" aria-hidden="true"></span> happy to chat, get in touch</p>
      </section>

      <section id="projects">
        <h2 class="mono label">~ $ ls projects/</h2>
        <ul class="rows">
          {work.map((w) => (
            <li class:list={["row", { todo: w.todo }]}>
              <div class="row-main">
                {w.href ? <a href={w.href} target="_blank" rel="noopener">{w.name}</a> : <span class="name">{w.name}</span>}
                <span class="mono org">{w.org}</span>
              </div>
              <p class="blurb">{w.about}</p>
              <p class="did">{w.did}</p>
              <ul class="mono tags small">
                {w.tags.map((t) => <li>{t}</li>)}
              </ul>
              <span class="mono year">{w.year}</span>
            </li>
          ))}
        </ul>
        <ul class="more">
          {more.map((m) => (
            <li>
              {m.href ? <a href={m.href}>{m.name}</a> : <span>{m.name}</span>}
              <span class="mono org">{m.org}</span>
              <span class="mono year">{m.year}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="experience">
        <h2 class="mono label">~ $ cat experience.txt</h2>
        <ul class="rows">
          {experience.map((e) => (
            <li class:list={["row", { todo: e.todo }]}>
              <div class="row-main">
                <span class="name">{e.role}</span>
                <span class="mono org">{e.org}</span>
              </div>
              <span class="mono year">{e.when}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="stack">
        <h2 class="mono label">~ $ cat stack.txt</h2>
        <dl class="stack">
          {stack.map((g) => (
            <div>
              <dt class="mono">{g.group}</dt>
              <dd>
                <ul class="mono tags">
                  {g.items.map((t) => <li>{t}</li>)}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="contact" class="contact">
        <h2 class="mono label">~ $ contact</h2>
        <p class="big">
          Hiring? <a href="mailto:lachlanjharnett@gmail.com">lachlanjharnett@gmail.com</a>
        </p>
        <ul class="mono links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </section>
    </main>

    <footer class="wrap mono foot">© {new Date().getFullYear()} rnett.au</footer>
  </body>
</html>
